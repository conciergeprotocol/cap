{
  "buildCommand": "bun run build",
  "installCommand": "bun install",
  "outputDirectory": "site/dist",
  "framework": null,
  "cleanUrls": true,
  "redirects": [
    { "source": "/owners", "destination": "/publish", "permanent": true }
  ],
  "functions": {
    "api/check.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/cap.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/implement.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    }
  ]
}
