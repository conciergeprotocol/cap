{
  "buildCommand": "bun run build",
  "installCommand": "bun install",
  "outputDirectory": "site/dist",
  "framework": null,
  "cleanUrls": true,
  "redirects": [
    { "source": "/owners", "destination": "/publish", "permanent": true }
  ],
  "rewrites": [
    { "source": "/cap/v1", "destination": "https://dapi.cosmicjs.com/v3/cap/v1/ck_02ab6bf29e54a4eeac6654f912281f34" },
    { "source": "/cap/v1/messages", "destination": "https://dapi.cosmicjs.com/v3/cap/v1/ck_02ab6bf29e54a4eeac6654f912281f34/messages" },
    { "source": "/cap/v1/messages/:messageId", "destination": "https://dapi.cosmicjs.com/v3/cap/v1/ck_02ab6bf29e54a4eeac6654f912281f34/messages/:messageId" },
    { "source": "/cap/v1/:path*", "destination": "https://dapi.cosmicjs.com/v3/cap/v1/:path*" },
    { "source": "/readiness/og/:domain", "destination": "/api/readiness-og?domain=:domain" },
    { "source": "/readiness/:domain", "destination": "/api/readiness-share?domain=:domain" }
  ],
  "functions": {
    "api/check.js": {
      "maxDuration": 30
    },
    "api/readiness.js": {
      "maxDuration": 60
    },
    "api/effectiveness.js": {
      "maxDuration": 300
    },
    "api/readiness-share.js": {
      "maxDuration": 15,
      "includeFiles": "{api/readiness-shell.html,site/dist/readiness.html}"
    }
  },
  "headers": [
    {
      "source": "/cap.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/implement.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/agent.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/.well-known/poppy.json",
      "headers": [{ "key": "Content-Type", "value": "application/json; charset=utf-8" }]
    },
    {
      "source": "/llms.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/llms-full.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/(.*\\.md)",
      "headers": [{ "key": "Content-Type", "value": "text/markdown; charset=utf-8" }]
    },
    {
      "source": "/",
      "headers": [{ "key": "Link", "value": "</agent.txt>; rel=\"agent\"" }]
    }
  ]
}
